# App & URLs
NODE_ENV=development
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/my_healthy_mentor
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=my_healthy_mentor

# Google OAuth (Better Auth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Invite-Only Access Control (comma-separated emails seeded into allowlist_entries)
ADMIN_EMAIL=you@gmail.com
ALLOWED_EMAILS=

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=replace-with-random-webhook-secret

# Free-Tier AI Providers (Vercel AI SDK)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
AI_CHAT_MODEL=gemini-2.5-flash
AI_STRUCTURED_MODEL=gemini-2.5-flash
AI_AUDIO_MODEL=gemini-2.5-flash

# Local Persistent Storage
PHOTOS_DIR=/data/photos
